@model ML.Restaurante
@{
    ViewBag.Title = "Restaurantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Restaurantes</h2>

@Html.ActionLink("Agregar", "Formulario", "Restaurante", new { @class = "btn btn-success" })

<div class="container table-responsive">
    <div class="row">
        <table class="table table-sm table-info table-striped table-bordered border-primary text-nowrap">
            <thead>
                <tr>
                    <th scope="col">Imagen</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Hora de apertura</th>
                    <th scope="col">Hora de cierre</th>
                    <th scope="col">Telefono</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Estatus</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ML.Restaurante rest in @Model.Restaurantes)
                {
                    <tr>
                        @if (rest.Imagen != null)
                        {
                            <td><img width="150" src="data:imagen/*;base64,@Convert.ToBase64String(rest.Imagen)" /></td>
                        }
                        else
                        {
                            <td>
                                <img width="150" src="~/Content/Imagen/vector-49-corporate-logos-design-template-set.jpg" /></td>
                                }
                            <td>@rest.Nombre</td>
                            <td>@rest.HorarioApertura</td>
                            <td>@rest.HorarioCierre</td>
                            <td>@rest.Telefono</td>
                            <td>@rest.Correo</td>
                            <td>@rest.Descripcion</td>
                            <td>@rest.Estatus</td>
                            <td>
                                <a href="@Url.Action("Formulario", "Restaurante", new { idRestaurante = rest.IdRestaurante })" class="btn btn-sm btn-outline-warning bi bi-pencil-square"></a>
                                <a href="@Url.Action("Delete", "Restaurante", new { idRestaurante = rest.IdRestaurante })" onclick="return confirm('Eliminar el registro')" class="btn btn-sm btn-outline-danger bi bi-person-x"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>